#!/bin/sh
# Generated by CMake from run.sh.in
# usage: run.sh <p> input.mlir
set -eu
if [ "$#" -ne 2 ]; then
  echo "usage: $0 <p> input.mlir" >&2
  exit 2
fi
"@MLIR_OPT@" --load-pass-plugin="$<TARGET_FILE:ModPAnalysis>" \
  --pass-pipeline="builtin.module(mod-p-analysis{p=$1})" \
  "$2" -o /dev/null
